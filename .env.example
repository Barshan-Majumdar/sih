# ==============================================================================
# SIH26122 Infrastructure Progress Tracking & Schedule Linking Platform
# Unified Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/sih2?sslmode=prefer"
DIRECT_URL="postgresql://username:password@localhost:5432/sih2?sslmode=prefer"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Clerk Auth)
# Get keys from: https://dashboard.clerk.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_with_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_replace_with_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ------------------------------------------------------------------------------
# 3. AI PROVIDER CONFIGURATION
# PRIORITY #1: Google Gemini (Primary Engine for Extraction & Copilot)
# Get key from: https://aistudio.google.com
# ------------------------------------------------------------------------------
GEMINI_API_KEY="replace_with_google_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"

# PRIORITY #2: OpenAI (Secondary / Fallback Engine)
# Get key from: https://platform.openai.com
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# PRIORITY #3: OpenRouter (Optional emergency fallback)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_FALLBACK_MODELS="openrouter/free"
ASSISTANT_MAX_RETRIES="2"
AI_CHAT_RATE_LIMIT_PER_MINUTE="30"

# ------------------------------------------------------------------------------
# 4. PYTHON UNIFIED AI RETRIEVAL & OCR MICROSERVICE (Single Port 8000)
# FastAPI server running BM25 + FAISS Vector Search + 8-Signal Reranker + OCR/PDF conversion
# ------------------------------------------------------------------------------
RETRIEVAL_SERVICE_URL="http://localhost:8000"
OCR_SERVICE_URL="http://localhost:8000"
OCR_SERVICE_TOKEN="dev-local-ocr-token"
OCR_SERVICE_TIMEOUT_MS="120000"

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (Cloudflare R2 or Local Disk Fallback)
# Leave unset in local development to automatically save to public/uploads/
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ------------------------------------------------------------------------------
# 7. NOTIFICATIONS & EMAIL (Optional Gmail SMTP)
# Leave unset to skip email delivery entirely (app runs normally)
# ------------------------------------------------------------------------------
GOOGLE_USER=""
GOOGLE_AUTH_APP_PASSWORD=""
EMAIL_FROM="InfraTrack PM <>"
